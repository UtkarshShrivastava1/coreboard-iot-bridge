{
  "dev-command-auto-approver": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node .agents/hooks/auto_approve.js",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
